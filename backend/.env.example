# Corob Analytics — Backend Environment Configuration Template
# Copy this file to .env and fill in real values. Never commit .env to git.

# ── MySQL (Ubuntu server) ──────────────────────────────────────────────────────
# Hostname or IP of the Ubuntu MySQL server (e.g. 192.168.1.10 or db.internal)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=corob
MYSQL_PASSWORD=
MYSQL_DATABASE=corob_service

# Connection pool size (tune per server RAM / expected concurrency)
MYSQL_POOL_SIZE=10

# Optional: enable TLS to the MySQL server
# MYSQL_SSL=true
# MYSQL_SSL_CA=/path/to/ca-cert.pem

# ── Security ──────────────────────────────────────────────────────────────────
# Must be >= 32 random characters. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# JWT lifetime in seconds (default 600 = 10 minutes)
JWT_TTL_SECONDS=600

# Session TTL for uploaded Service Call data (seconds, default 3600 = 1 hour)
SESSION_TTL_SECONDS=3600

# HMAC key for blob integrity checks (defaults to JWT_SECRET if unset)
# DATA_SIGNING_KEY=

# ── CORS / hosting ────────────────────────────────────────────────────────────
# The exact origin the frontend is served from (no trailing slash)
ALLOWED_ORIGIN=http://localhost:5173

# Additional trusted host names/IPs (comma-separated), or * to disable check
# ALLOWED_HOSTS=192.168.1.100

# ── PM data ───────────────────────────────────────────────────────────────────
# PM records are stored permanently in MySQL (pm_data table).
# This variable is retained for legacy compatibility but no longer used as an
# expiry; uploaded Excel data persists until explicitly replaced by a new upload.
PM_DATA_TTL_SECONDS=2592000

# ── Misc ──────────────────────────────────────────────────────────────────────
# First month of the fiscal year (1=Jan … 4=Apr … 12=Dec)
FISCAL_YEAR_START_MONTH=4

# Set to 1 to enable /docs and /openapi.json (dev only)
# ENABLE_DOCS=1

# Append-only PM action log (defaults to backend/data/pm_labels.jsonl)
# PM_LABEL_LOG=/var/log/corob/pm_labels.jsonl

