[Unit]
Description=Corob Service Analytics — FastAPI backend
After=network.target mysql.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/corob-analytics/backend
Environment=MPLCONFIGDIR=/tmp/matplotlib
EnvironmentFile=/var/www/corob-analytics/backend/.env
ExecStart=/usr/bin/python3 -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
